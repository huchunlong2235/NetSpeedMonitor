<Window x:Class="NetSpeedMonitor.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        SizeToContent="Height" Width="350" ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Border Margin="10" Background="#FFFFFF" CornerRadius="8"
            BorderBrush="#E3E6EA" BorderThickness="1" Padding="14,12"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#33000000" BlurRadius="14" ShadowDepth="2"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="30" Height="30" CornerRadius="15" Background="#E6F4ED"
                    VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="✓" FontSize="16" Foreground="#0F9E6E"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="内存清理完成" FontSize="13" FontWeight="SemiBold" Foreground="#1F2328"/>
                <TextBlock x:Name="DetailText" Text="" FontSize="12" Foreground="#5F5E5A"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
