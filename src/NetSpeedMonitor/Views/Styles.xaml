<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:NetSpeedMonitor.Helpers">

    <helpers:HexToBrushConverter x:Key="HexToBrush"/>
    <helpers:HexOpacityToBrushConverter x:Key="HexOpacityToBrush"/>
    <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    <helpers:OrientationToBoolConverter x:Key="OrientationToBool"/>
    <helpers:PercentToWidthConverter x:Key="PercentToWidth"/>
    <helpers:DoubleToStringConverter x:Key="DoubleToString"/>

    <Style TargetType="TextBlock" x:Key="LabelText">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#5F5E5A"/>
    </Style>

    <Style TargetType="TextBox" x:Key="HexInput">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- 可点击色卡：背景色由绑定注入，点击弹出系统选色器 -->
    <Style TargetType="Button" x:Key="ColorSwatch">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#A0A0A0" BorderThickness="1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#666"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#2B7DE9"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider" x:Key="ValueSlider">
        <Setter Property="Height" Value="24"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
