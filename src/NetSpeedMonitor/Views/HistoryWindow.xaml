<Window x:Class="NetSpeedMonitor.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史网速曲线 · 近 5 分钟" Height="400" Width="780"
        WindowStartupLocation="CenterScreen" Background="#FFFFFF"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Border Width="12" Height="12" CornerRadius="2" Background="#0F9E6E" Margin="0,0,6,0"/>
            <TextBlock Text="上传" Style="{StaticResource LabelText}" Margin="0,0,20,0"/>
            <Border Width="12" Height="12" CornerRadius="2" Background="#185FA5" Margin="0,0,6,0"/>
            <TextBlock Text="下载" Style="{StaticResource LabelText}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="22"/>
            </Grid.RowDefinitions>

            <!-- Y 轴速度刻度 -->
            <Canvas x:Name="YAxisCanvas" Grid.Column="0" Grid.Row="0">
                <TextBlock x:Name="YLabel0" Style="{StaticResource LabelText}" FontSize="10" Width="52" TextAlignment="Right"/>
                <TextBlock x:Name="YLabel1" Style="{StaticResource LabelText}" FontSize="10" Width="52" TextAlignment="Right"/>
                <TextBlock x:Name="YLabel2" Style="{StaticResource LabelText}" FontSize="10" Width="52" TextAlignment="Right"/>
                <TextBlock x:Name="YLabel3" Style="{StaticResource LabelText}" FontSize="10" Width="52" TextAlignment="Right"/>
            </Canvas>

            <!-- 曲线区 -->
            <Grid x:Name="ChartContainer" Grid.Column="1" Grid.Row="0" ClipToBounds="True">
                <Canvas x:Name="ChartCanvas" SizeChanged="ChartCanvas_SizeChanged">
                    <Line x:Name="GridLine0" Stroke="#EEEEEE" StrokeThickness="1" StrokeDashArray="4,3"/>
                    <Line x:Name="GridLine1" Stroke="#EEEEEE" StrokeThickness="1" StrokeDashArray="4,3"/>
                    <Line x:Name="GridLine2" Stroke="#EEEEEE" StrokeThickness="1" StrokeDashArray="4,3"/>
                    <Line x:Name="GridLine3" Stroke="#EEEEEE" StrokeThickness="1" StrokeDashArray="4,3"/>
                    <Polyline x:Name="UploadLine" Stroke="#0F9E6E" StrokeThickness="2" Fill="Transparent"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Polyline x:Name="DownloadLine" Stroke="#185FA5" StrokeThickness="2" Fill="Transparent"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
                <TextBlock x:Name="EmptyHint" Text="暂无数据，采样几秒后再查看"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#9AA0A6" FontSize="13"/>
            </Grid>

            <!-- X 轴时间刻度 -->
            <Canvas x:Name="XAxisCanvas" Grid.Column="1" Grid.Row="1">
                <TextBlock x:Name="XLabel0" Style="{StaticResource LabelText}" FontSize="10" Foreground="#9AA0A6" Width="110" TextAlignment="Left"/>
                <TextBlock x:Name="XLabel1" Style="{StaticResource LabelText}" FontSize="10" Foreground="#9AA0A6" Width="110" TextAlignment="Center"/>
                <TextBlock x:Name="XLabel2" Style="{StaticResource LabelText}" FontSize="10" Foreground="#9AA0A6" Width="110" TextAlignment="Right"/>
            </Canvas>
        </Grid>

        <TextBlock x:Name="ScaleLabel" Grid.Row="2" Text="" Style="{StaticResource LabelText}" Margin="0,8,0,0"/>
    </Grid>
</Window>
